# game2d: reusable, engine-independent 2D game primitives.
# These are plain Bolt maps and functions, so they work with the VM, native
# Preview, and future backends without locking games to one renderer.

func vec2(x, y) {
    return {"x": x, "y": y}
}

func body(x, y, w, h) {
    return {"x": x, "y": y, "w": w, "h": h, "vx": 0, "vy": 0,
        "ax": 0, "ay": 0, "grounded": false}
}

func move(b, dt) {
    let state = physics_step(b["x"], b["y"], b["vx"], b["vy"], b["ax"], b["ay"], dt)
    b["x"] = state[0]
    b["y"] = state[1]
    return b
}

func overlaps(a, b) {
    return rects_overlap(a["x"], a["y"], a["w"], a["h"], b["x"], b["y"], b["w"], b["h"])
}

func keep_inside(b, left, top, right, bottom) {
    b["x"] = clamp(b["x"], left, right - b["w"])
    b["y"] = clamp(b["y"], top, bottom - b["h"])
    return b
}

func accelerate_input(b, left_pressed, right_pressed, acceleration, max_speed, dt) {
    if left_pressed { b["vx"] = b["vx"] - acceleration * dt }
    if right_pressed { b["vx"] = b["vx"] + acceleration * dt }
    b["vx"] = clamp(b["vx"], -max_speed, max_speed)
    return b
}

func resolve_floor(b, floor_y, bounce) {
    if b["y"] + b["h"] >= floor_y and b["vy"] > 0 {
        b["y"] = floor_y - b["h"]
        b["vy"] = -b["vy"] * bounce
        b["grounded"] = true
    }
    return b
}

# Move a body through a list of solid rectangle bodies using axis-separated
# collision resolution. The body keeps useful platformer state in-place:
# grounded, hit_left, hit_right, and hit_ceiling. Solids only need x/y/w/h.
# This is deliberately renderer-independent, so it works in VM and native
# Preview alike.
func move_and_collide(b, solids, dt) {
    b["grounded"] = false
    b["hit_left"] = false
    b["hit_right"] = false
    b["hit_ceiling"] = false

    b["x"] = b["x"] + b["vx"] * dt
    for solid in solids {
        if overlaps(b, solid) {
            if b["vx"] > 0 {
                b["x"] = solid["x"] - b["w"]
                b["hit_right"] = true
            } else if b["vx"] < 0 {
                b["x"] = solid["x"] + solid["w"]
                b["hit_left"] = true
            }
            b["vx"] = 0
        }
    }

    b["y"] = b["y"] + b["vy"] * dt
    for solid in solids {
        if overlaps(b, solid) {
            if b["vy"] > 0 {
                b["y"] = solid["y"] - b["h"]
                b["grounded"] = true
            } else if b["vy"] < 0 {
                b["y"] = solid["y"] + solid["h"]
                b["hit_ceiling"] = true
            }
            b["vy"] = 0
        }
    }
    return b
}

func jump(b, speed) {
    if b["grounded"] {
        b["vy"] = -speed
        b["grounded"] = false
    }
    return b
}

func draw_body(win, b, color) {
    rect(win, b["x"], b["y"], b["w"], b["h"], color)
    return nil
}
