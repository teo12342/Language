# mathutils: small math helpers beyond the built-in sqrt/abs/min/max.

func square(x) {
    return x * x
}

func cube(x) {
    return x * x * x
}

func is_even(n) {
    return n % 2 == 0
}

func is_odd(n) {
    return n % 2 != 0
}

func factorial(n) {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

func is_prime(n) {
    if n < 2 {
        return false
    }
    let i = 2
    while i * i <= n {
        if n % i == 0 {
            return false
        }
        i = i + 1
    }
    return true
}

func gcd(a, b) {
    while b != 0 {
        let t = b
        b = a % b
        a = t
    }
    return a
}
