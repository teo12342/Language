# A minimal, real web server: serve() starts an actual HTTP server and
# calls this function once per request, with the request path as input.
# The response is whatever string this function returns - a different
# page for every path, computed live by Bolt code.

func page(path) {
    if path == "/" {
        return "<h1>Hello from Bolt</h1><p>This page is served by a Bolt script.</p>"
    }
    if path == "/about" {
        return "<h1>About</h1><p>Bolt has a VM, a native compiler, a JS transpiler, and now a tiny web server.</p>"
    }
    return "<h1>404</h1><p>No page at " + path + "</p>"
}

# Answers 3 requests then stops (pass 0 to run forever, like a normal server).
serve(8080, page, 3)
