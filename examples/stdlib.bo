# A tour of Bolt's expanded standard library.

print(sqrt(16), abs(-5), min(3, 1, 2), max([3, 1, 2]))
print(floor(3.7), ceil(3.2), round(3.456, 2), pow(2, 10))

print(trim("  padded  "))
print(replace("hello world", "world", "bolt"))
print(starts_with("bolt.bo", "bolt"), ends_with("bolt.bo", ".bo"))

let nums = [5, 3, 1, 4, 2]
print(sort(nums))
print(reverse(nums))
print(contains(nums, 4), index_of(nums, 4))
print(slice(nums, 1, 3))
print(concat([1, 2], [3, 4]))

# Tensors: transpose, identity, and elementwise map with a Bolt function.
let m = tensor([[1, 2, 3], [4, 5, 6]])
print(tolist(transpose(m)))
print(tolist(identity(3)))

func double(x) { return x * 2 }
print(tolist(tmap(tensor([1, 2, 3]), double)))
