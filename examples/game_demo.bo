# A real, playable Bolt game: move a square around a window with the
# arrow keys. window()/rect()/key()/tick() are backed by a real tkinter
# window - an actual on-screen game, not a simulation.

let win = window(480, 320, "Bolt Game Demo")

let x = 220
let y = 140
let speed = 4

while tick(win, 60) {
    if key(win, "left") { x = x - speed }
    if key(win, "right") { x = x + speed }
    if key(win, "up") { y = y - speed }
    if key(win, "down") { y = y + speed }

    if x < 0 { x = 0 }
    if x > 440 { x = 440 }
    if y < 0 { y = 0 }
    if y > 280 { y = 280 }

    clear(win, "#171410")
    rect(win, x, y, 40, 40, "#e2895f")
    draw_text(win, 10, 10, "Arrow keys to move", "#a89d86")

    if key(win, "escape") {
        close_window(win)
    }
}

print("window closed")
