# Same benchmark as bench.nx, but fib is annotated 'number' so --native
# can AOT-compile just that hot path to C while everything else
# (bubble_sort, word_count) still runs through the normal engine.

func fib(n: number): number {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

func make_list(n, seed) {
    let lst = []
    let x = seed
    for i in range(n) {
        x = (x * 1103515245 + 12345) % 2147483648
        push(lst, x % 10000)
    }
    return lst
}

func bubble_sort(lst) {
    let n = len(lst)
    let i = 0
    while i < n {
        let j = 0
        while j < n - i - 1 {
            if lst[j] > lst[j + 1] {
                let tmp = lst[j]
                lst[j] = lst[j + 1]
                lst[j + 1] = tmp
            }
            j = j + 1
        }
        i = i + 1
    }
    return lst
}

func word_count(text) {
    let words = split(text, " ")
    let counts = {}
    for w in words {
        counts[w] = 0
    }
    for w in words {
        counts[w] = counts[w] + 1
    }
    return counts
}

let text = "the quick brown fox jumps over the lazy dog the fox runs the dog barks the fox hides"

print("fib(27) =", fib(27))

let sorted_list = bubble_sort(make_list(600, 42))
print("sorted first 5:", [sorted_list[0], sorted_list[1], sorted_list[2], sorted_list[3], sorted_list[4]])
print("sorted last:", sorted_list[len(sorted_list) - 1])

let counts = word_count(text)
print("word 'the' count:", counts["the"])
print("word 'fox' count:", counts["fox"])
