# generate_page.bo
# Generates the HTML body for the "Bolt vs. the Classics" report page.
# This script IS the page: every row of the ratings grid, every bar in
# the chart, and the whole version timeline are built by Bolt code
# (loops over lists of maps, string concatenation, functions) and
# printed as one HTML document. Run with:
#   python cli.py generate_page.bo > page_body.html

func star_bar(score) {
    let out = ""
    let i = 0
    while i < score {
        out = out + "&#9733;"
        i = i + 1
    }
    let off = 10 - score
    let j = 0
    while j < off {
        out = out + "&#9734;"
        j = j + 1
    }
    return out
}

func rating_row(who, cls, score, best) {
    let badge = ""
    if best {
        badge = "<span class=\"winner-badge\">best</span>"
    }
    let winner_class = ""
    if best {
        winner_class = " winner"
    }
    let head = "<div class=\"rating-row " + cls + winner_class + "\"><span class=\"rating-who\">" + who + "</span>"
    let mid = "<span class=\"stars\">" + star_bar(score) + "</span>"
    let tail = "<span class=\"rating-score\">" + str(score) + "/10</span>" + badge + "</div>"
    return head + mid + tail
}

func rating_card(title, why, rows) {
    let opener = "<div class=\"rating-card\"><div class=\"rating-title\">" + title + "</div>"
    let sub = "<div class=\"rating-why\">" + why + "</div>"
    let body = opener + sub
    for row in rows {
        body = body + rating_row(row["who"], row["cls"], row["score"], row["best"])
    }
    return body + "</div>"
}

func version_item(badge, desc, current) {
    let cls = "version-item"
    if current {
        cls = "version-item current"
    }
    let head = "<div class=\"" + cls + "\"><span class=\"version-badge\">" + badge + "</span>"
    let body = "<div class=\"version-desc\">" + desc + "</div></div>"
    return head + body
}

func verdict_box(label, value, cls, best) {
    let value_cls = "value"
    if best {
        value_cls = "value win"
    }
    let head = "<div class=\"verdict\"><div class=\"label\">" + label + "</div>"
    let val = "<div class=\"" + value_cls + " " + cls + "\">" + value + "</div></div>"
    return head + val
}

func legend_item(label, cls, age) {
    let head = "<span class=\"legend-item\"><span class=\"dot " + cls + "\"></span>" + label
    return head + " <span class=\"age\">&middot; " + age + "</span></span>"
}

func bar_row(label, cls, value, width) {
    let head = "<div class=\"bar-row\"><div class=\"bar-label\"><span>" + label + "</span>"
    let mid = "<span class=\"time\">" + value + "</span></div>"
    let fillopen = "<div class=\"bar-track\"><div class=\"bar-fill " + cls + "\" style=\"width:" + str(width) + "%\">"
    let val = "<span class=\"bar-value\">" + label + " &middot; " + value + "</span></div></div></div>"
    return head + mid + fillopen + val
}

let html = ""

html = html + "<div class=\"wrap\"><header><p class=\"eyebrow\">Generated by a Bolt script, not hand-written HTML</p>"
html = html + "<h1><span class=\"bolt\">Bolt</span> <span class=\"vs\">vs. Python, JavaScript, C, and C++</span></h1>"
html = html + "<p class=\"dek\">This entire page body is built by generate_page.bo, a real Bolt program, and printed as HTML by the actual Bolt interpreter. Not a template describing Bolt: Bolt output. Now five languages and a new category: game development.</p>"
html = html + "<p class=\"version-tag\">Rendered by Bolt v0.14.0 via python cli.py generate_page.bo</p>"

html = html + "<div class=\"legend\">"
html = html + legend_item("Bolt", "bolt", "days old")
html = html + legend_item("Python", "python", "1991, 35 years")
html = html + legend_item("JavaScript", "js", "1995, 31 years")
html = html + legend_item("C", "c", "1972, 54 years")
html = html + legend_item("C++", "cpp", "1985, 41 years")
html = html + "</div></header>"

html = html + "<section id=\"verdict\">"
html = html + "<h2>fib(30), the number that matters most, first</h2>"
html = html + "<p class=\"section-note\">Every language's raw speed on the same workload, before any of the category breakdowns below. C, C++, and Bolt (native) are all close enough to be noise; JavaScript and Python trail behind. Honesty note: C++ and Bolt's native number were both freshly measured this session; C, JS, and Python's are carried over from earlier in this project and have not been re-verified on this machine.</p>"
html = html + "<div class=\"verdict-strip\">"
html = html + verdict_box("C", "0.003 s", "c", true)
html = html + verdict_box("C++", "0.004 s", "cpp", true)
html = html + verdict_box("Bolt (native)", "0.005 s", "bolt", true)
html = html + verdict_box("JavaScript", "0.046 s", "js", false)
html = html + verdict_box("Python", "0.122 s", "python", false)
html = html + "</div></section>"

html = html + "<section id=\"ratings\"><h2>Category ratings, generated by a for-loop</h2>"
html = html + "<p class=\"section-note\">Each card below came from calling rating_card() with a list of maps - the loop that assembles each row is Bolt's own for-in loop, not a hand-copied HTML block.</p>"
html = html + "<div class=\"rating-grid\">"

let card1_rows = [{"who": "C", "cls": "c", "score": 10, "best": true}, {"who": "C++", "cls": "cpp", "score": 10, "best": true}, {"who": "Bolt", "cls": "bolt", "score": 10, "best": true}, {"who": "JavaScript", "cls": "js", "score": 8, "best": false}, {"who": "Python", "cls": "python", "score": 5, "best": false}]
html = html + rating_card("Raw execution speed", "fib(30), each language's own best/normal mode. C++'s 0.004s and Bolt's 0.005s (native execution only, excluding one-time compile) were both freshly measured this session, within noise of C's 0.003s - fixing a real bug in Bolt's native compiler (it silently failed on this machine before this session). Important caveat: Bolt's number only applies via the opt-in --native flag, on a narrow subset of number-only functions. Bolt's default engine, the bytecode VM everything else runs on, ran this same fib(30) in about 17 seconds on this machine - roughly 100x slower than Python. The 10/10 reflects Bolt's best case, not its typical case.", card1_rows)

let card2_rows = [{"who": "Bolt", "cls": "bolt", "score": 9, "best": true}, {"who": "C++", "cls": "cpp", "score": 3, "best": false}, {"who": "C", "cls": "c", "score": 3, "best": false}, {"who": "Python", "cls": "python", "score": 3, "best": false}, {"who": "JavaScript", "cls": "js", "score": 3, "best": false}]
html = html + rating_card("Multiple execution backends, one project", "Interpreter, VM, native compiler, JS transpiler, and a web server, all one codebase. The other four tie at 3: each has multiple implementations (GCC/Clang/MSVC, CPython/PyPy, V8/SpiderMonkey), but as separate outside projects, not one project offering several paths - structurally the same situation for all four, so they get the same score.", card2_rows)

let card3_rows = [{"who": "JavaScript", "cls": "js", "score": 10, "best": true}, {"who": "Python", "cls": "python", "score": 10, "best": true}, {"who": "C++", "cls": "cpp", "score": 8, "best": false}, {"who": "C", "cls": "c", "score": 7, "best": false}, {"who": "Bolt", "cls": "bolt", "score": 4, "best": false}]
html = html + rating_card("Ecosystem and libraries", "npm and PyPI are enormous. C++ has vcpkg/Conan and decades of libraries, ahead of plain C. Bolt has import(), pyimport(), and a tiny package registry.", card3_rows)

let card4_rows = [{"who": "Python", "cls": "python", "score": 9, "best": true}, {"who": "Bolt", "cls": "bolt", "score": 8, "best": false}, {"who": "JavaScript", "cls": "js", "score": 6, "best": false}, {"who": "C", "cls": "c", "score": 3, "best": false}, {"who": "C++", "cls": "cpp", "score": 2, "best": false}]
html = html + rating_card("Learning curve", "Bolt was deliberately designed to read like Python. C++ rates below plain C: everything C has, plus templates, multiple inheritance, and manual memory management now shared with smart-pointer ownership rules.", card4_rows)

let card5_rows = [{"who": "C++", "cls": "cpp", "score": 10, "best": true}, {"who": "JavaScript", "cls": "js", "score": 6, "best": false}, {"who": "Python", "cls": "python", "score": 5, "best": false}, {"who": "C", "cls": "c", "score": 5, "best": false}, {"who": "Bolt", "cls": "bolt", "score": 2, "best": false}]
html = html + rating_card("Game development", "C++ is the unambiguous industry standard: Unreal, id Tech, CryEngine, most AAA studios build on it directly. JavaScript has mature, widely-used 2D/3D libraries (Phaser, three.js, PixiJS) with a huge web/casual game market and real shipped titles. Python's PyGame is real and popular for education and prototyping, but a smaller commercial footprint than JS's game ecosystem. C built the earliest engines (Doom, Quake) and can still do it today, but has no built-in graphics or windowing - you reach for a C library like SDL, same as any other language would. Bolt got window(), drawing, key(), tick(), collision, and beep() this session - real and working, but three builtins with one demo behind them is a toy, not a game-dev option yet: no sprite animation, no audio mixing, no physics, no scene graph, no community, no shipped games. Rated honestly low, not bumped to look impressive.", card5_rows)

html = html + "</div></section>"

html = html + "<section id=\"chart\"><h2>fib(30), one bar per language</h2>"
html = html + "<p class=\"section-note\">C++ and Bolt (native)'s numbers were both measured fresh this session. Python and JavaScript's are carried over from earlier work on this project and were not re-verified this session. Bolt's bar is native-execution-only (compile time excluded) on a narrow number-only-function subset via --native - not its default engine, which is dramatically slower (see the caveat above).</p>"
html = html + "<div class=\"chart\">"
html = html + bar_row("Python", "python", "0.122 s", 100)
html = html + bar_row("JavaScript", "js", "0.046 s", 38)
html = html + bar_row("Bolt (native)", "bolt", "0.005 s", 4)
html = html + bar_row("C++", "cpp", "0.004 s", 3)
html = html + bar_row("C", "c", "0.003 s", 2)
html = html + "</div></section>"

html = html + "<section id=\"versions\"><h2>Version history, built from a Bolt list</h2><div class=\"version-timeline\">"

let versions = [{"badge": "v0.7.0", "desc": "Added the built-in serve() web server.", "current": false}, {"badge": "v0.8.0", "desc": "Grew the standard library (math, string, tensor utilities).", "current": false}, {"badge": "v0.9.0", "desc": "Native compiler gained math functions; JS transpiler's tensor gap closed.", "current": false}, {"badge": "v0.10.0", "desc": "A real import() module system plus a small local package registry.", "current": false}, {"badge": "v0.11.0", "desc": "pyimport(): a Python interop bridge into Python's real standard library.", "current": false}, {"badge": "v0.12.0", "desc": "window(): a real drawable window, keyboard input, and a game loop - first step toward game development.", "current": false}, {"badge": "v0.13.0", "desc": "draw_image(), collision detection, and beep()/play_sound() - sprites, collision, and sound for game dev.", "current": false}, {"badge": "v0.14.0", "desc": "Fixed --native on MSVC-only Windows: was hardcoded to gcc (crashed), and had a real symbol-collision bug (a Bolt function named e.g. hypot silently clashed with math.h). Native execution now genuinely matches C/C++ speed.", "current": true}]

for v in versions {
    html = html + version_item(v["badge"], v["desc"], v["current"])
}

html = html + "</div></section>"

html = html + "<footer><span>generate_page.bo - run via the real Bolt interpreter, not simulated</span><span>python cli.py generate_page.bo</span></footer></div>"

print(html)
